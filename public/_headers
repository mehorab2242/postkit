# Cloudflare Pages headers. Copied into the export as-is.

# Generated OG images are emitted without a file extension, so the content type
# has to be set explicitly or scrapers reject them.
/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
